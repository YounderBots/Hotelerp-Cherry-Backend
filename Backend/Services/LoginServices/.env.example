# =============================================================================
# LoginServices — environment TEMPLATE
# =============================================================================
# Copy this file to '.env' IN THIS DIRECTORY and fill in the blanks:
#     cp .env.example .env
#
# This service loads ONLY this directory's .env (see configs/__init__.py).
# The real .env is gitignored and MUST NOT be committed - it holds the DB
# password and the JWT signing key. This repo is public.
#
# CRITICAL: JWT_SECRET_KEY, SESSION_SECRET and JWT_ISSUER must be
# byte-for-byte IDENTICAL in all six services. LoginServices signs the
# tokens and the other five verify them - any mismatch 401s every request.
# =============================================================================

# One of: local | dev | production   (use 'production' when going live)
ASCEND_ENV=dev

# ---- This service ----------------------------------------------------------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ---- Secrets (REQUIRED in production - startup fails if unset) -------------
# Generate ONCE, then paste the SAME value into all six service .env files:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
SESSION_SECRET=
JWT_ISSUER=hotelerp-login
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ---- Database (this service's OWN schema) ----------------------------------
DB_URI=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/hotelerp_users
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- CORS ------------------------------------------------------------------
# Comma-separated. Wildcard '*' is rejected. Set this to the live SPA origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Cross-service base URLs -----------------------------------------------
USER_SERVICE_URL=http://127.0.0.1:8020
MASTER_SERVICE_URL=http://127.0.0.1:8030
HOTEL_SERVICE_URL=http://127.0.0.1:8040
RESTAURANT_SERVICE_URL=http://127.0.0.1:8050
BAR_SERVICE_URL=http://127.0.0.1:8060

# ---- Authorisation (LoginServices only) ------------------------------------
# off      no permission checks at all
# audit    checks run and are LOGGED, but nothing is refused   <-- THE DEFAULT
# enforce  a role without the permission is refused
#
# SET THIS TO 'enforce' IN PRODUCTION. The default is 'audit' so that switching
# a live property on does not lock its staff out mid-shift while the menus are
# still being set up -- but audit means every role can reach every endpoint and
# the denials are only written to the log.
#
# A deployment of this system ran in audit for exactly that reason: nothing
# mentioned the setting, so nobody set it, and a Front Desk account could read
# the full HRM staff list, salaries included.
#
# Verify after deploying:  python Backend/tools/preflight.py --host <server>
RBAC_GATEWAY_MODE=audit

# ---- Gateway behaviour (LoginServices only) --------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_BURST=3
PROXY_TIMEOUT_SECONDS=30
UPSTREAM_TIMEOUT_SECONDS=10

# ---- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
