# =============================================================================
# HotelServices — environment TEMPLATE
# =============================================================================
# Copy this file to '.env' IN THIS DIRECTORY and fill in the blanks:
#     cp .env.example .env
#
# This service loads ONLY this directory's .env (see configs/__init__.py).
# The real .env is gitignored and MUST NOT be committed - it holds the DB
# password and the JWT signing key. This repo is public.
#
# CRITICAL: JWT_SECRET_KEY, SESSION_SECRET and JWT_ISSUER must be
# byte-for-byte IDENTICAL in all six services. LoginServices signs the
# tokens and the other five verify them - any mismatch 401s every request.
# =============================================================================

# One of: local | dev | production   (use 'production' when going live)
ASCEND_ENV=dev

# ---- This service ----------------------------------------------------------
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8040

# ---- Secrets (REQUIRED in production - startup fails if unset) -------------
# Generate ONCE, then paste the SAME value into all six service .env files:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
SESSION_SECRET=
JWT_ISSUER=hotelerp-login
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ---- Master Data schema (READ CROSS-SCHEMA) --------------------------------
# This service reads Master Data's tables directly, on its own connection, so
# that an availability check and the booking that depends on it commit in ONE
# transaction -- a read over HTTP could not hold the row locks that make
# double-booking impossible.
#
# That means a deployment requirement, not just a setting:
#   * the Master Data schema must be on the SAME MySQL server as this one, and
#   * the user in DB_URI below must have SELECT on it.
#
# Break either and this service still starts, /healthz still answers, night
# audit and housekeeping still work -- and the reservation list, the
# reservation detail and the availability check answer 500. That is how it
# reached production once. /readyz now reports it and startup logs CRITICAL.
#
# Leave unset to derive it from DB_URI (<prefix>_hotel -> <prefix>_masterdata).
# Set it when the schema is named anything else.
# MASTERDATA_DB_SCHEMA=hotelerp_masterdata

# ---- Database (this service's OWN schema) ----------------------------------
DB_URI=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/hotelerp_hotel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- CORS ------------------------------------------------------------------
# Comma-separated. Wildcard '*' is rejected. Set this to the live SPA origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
