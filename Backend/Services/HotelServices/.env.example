# =============================================================================
# HotelServices — environment TEMPLATE
# =============================================================================
# Copy this file to '.env' IN THIS DIRECTORY and fill in the blanks:
#     cp .env.example .env
#
# This service loads ONLY this directory's .env (see configs/__init__.py).
# The real .env is gitignored and MUST NOT be committed - it holds the DB
# password and the JWT signing key. This repo is public.
#
# CRITICAL: JWT_SECRET_KEY, SESSION_SECRET and JWT_ISSUER must be
# byte-for-byte IDENTICAL in all six services. LoginServices signs the
# tokens and the other five verify them - any mismatch 401s every request.
# =============================================================================

# One of: local | dev | production   (use 'production' when going live)
ASCEND_ENV=dev

# ---- This service ----------------------------------------------------------
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8040

# ---- Secrets (REQUIRED in production - startup fails if unset) -------------
# Generate ONCE, then paste the SAME value into all six service .env files:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
SESSION_SECRET=
JWT_ISSUER=hotelerp-login
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ---- Cross-service access ---------------------------------------------------
# This service reaches Master Data and Users through the LoginServices gateway,
# using the caller's token. It does not read or write another service's MySQL
# schema and must not be granted cross-schema privileges.
#
# The gateway address may be left at the local default for a standard install.
# Set API_GATEWAY_URL when the gateway is elsewhere; the gateway can also
# advertise its own address in the caller's token.
API_GATEWAY_URL=http://127.0.0.1:8000

# ---- Database (this service's OWN schema) ----------------------------------
DB_URI=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/hotelerp_hotel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- CORS ------------------------------------------------------------------
# Comma-separated. Wildcard '*' is rejected. Set this to the live SPA origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880

# ---- Service-side permission guard (all services except LoginServices) -----
# A SECOND, independent copy of the gateway's permission map, living in the
# service that holds the data. See resources/route_policy.py (GENERATED -- do
# not edit; rebuild with Backend/tools/build_rbac_map.py).
#
# The gateway is the primary control and a good one. This exists because its
# model has a premise -- that the services are unreachable except through it --
# and on the deployment this was written for that premise was false, so the map
# could be stepped around by addressing a service port directly. A check at the
# far end does not depend on the premise.
#
# off     no checks
# audit   log what would be refused, allow the request   <- DEFAULT
# enforce refuse with 403
#
# `audit` is the default ON PURPOSE. This is the third authorisation control to
# change at once (with the gateway default and the bind guard), and switching on
# a new layer in the same deploy that changes two others is how an app goes down
# on deploy day. Deploy in audit, read the log, then set enforce.
#
# The map is proven to agree with the gateway's for all 279 routes
# (Backend/tests/test_route_policy.py), and the whole suite passes under
# enforce, so the flip is a config change -- not a code change.
#
# Read the audit log with:
#   grep rbac_would_deny .run-logs/hotel.log | head -50
#
# To rehearse without deploying at all:
#   ROUTE_POLICY_MODE=audit python Backend/tests/run_all.py
#   ROUTE_POLICY_MODE=enforce python Backend/tests/run_all.py
>> ROUTE_POLICY_MODE=audit