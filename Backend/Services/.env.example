# =============================================================================
# Per-service backend config — TEMPLATE
# =============================================================================
# Every backend service is self-contained: it loads ONLY its own .env, which
# lives next to main.py at Backend/Services/<ServiceName>/.env. Copy this file
# into each service directory as `.env` and fill it in.
#
#   LoginServices/.env  UserServices/.env  MasterDataServices/.env
#   HotelServices/.env  RestaurantServices/.env  BarServices/.env
#
# CRITICAL: JWT_SECRET_KEY, SESSION_SECRET and JWT_ISSUER MUST be byte-for-byte
# identical in EVERY service's .env — the gateway (LoginServices) signs tokens
# and the other five verify them; any mismatch = every authenticated request 401s.
# =============================================================================

# One of: local | dev | production
ASCEND_ENV=dev

# ---- This service -----------------------------------------------------------
# SERVICE_HOST/PORT are read by start-network.ps1 to know where to bind.
# Only the gateway (LoginServices) uses 0.0.0.0 (LAN); the rest use 127.0.0.1.
#   LoginServices=8000  UserServices=8020  MasterDataServices=8030
#   HotelServices=8040  RestaurantServices=8050  BarServices=8060
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8060

# ---- Secrets (REQUIRED in production; identical across ALL services) --------
# Generate once, paste the SAME value into every service:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
SESSION_SECRET=
JWT_ISSUER=hotelerp-login
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ---- Database (this service's OWN schema) -----------------------------------
#   LoginServices / UserServices -> hotelerp_users
#   MasterDataServices           -> hotelerp_masterdata
#   HotelServices                -> hotelerp_hotel
#   RestaurantServices           -> hotelerp_restaurant
#   BarServices                  -> hotelerp_bar
DB_URI=mysql+pymysql://USER:PASS@127.0.0.1:3306/hotelerp_bar
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- CORS -------------------------------------------------------------------
# Must include the origin the SPA is served from (LAN IP + frontend port).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Cross-service base URLs ------------------------------------------------
# Needed by LoginServices (proxies to all five) and by Restaurant/Bar (call
# masterdata). Harmless to include in services that do not call out.
USER_SERVICE_URL=http://127.0.0.1:8020
MASTER_SERVICE_URL=http://127.0.0.1:8030
HOTEL_SERVICE_URL=http://127.0.0.1:8040
RESTAURANT_SERVICE_URL=http://127.0.0.1:8050
BAR_SERVICE_URL=http://127.0.0.1:8060

# ---- Gateway behaviour (LoginServices only; harmless elsewhere) -------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_BURST=3
PROXY_TIMEOUT_SECONDS=30
UPSTREAM_TIMEOUT_SECONDS=10

# ---- Uploads ----------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
