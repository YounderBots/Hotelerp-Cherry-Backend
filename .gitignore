.mypy_cache/
.ruff_cache/

# Python test coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node / frontend build output
node_modules/
Frontend/dist/
Frontend/build/
Frontend/storybook-static/
Frontend/coverage/
