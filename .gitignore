# OS files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Crash/debug dumps
*.stackdump

# Service run logs (bar_services.log, restaurant_services.log, etc.)
*.log
.run-logs/

# Secrets — never commit a populated env file. See .env.example for the contract.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python test coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node / frontend build output
node_modules/
Frontend/dist/
Frontend/build/
Frontend/storybook-static/
Frontend/coverage/
.vite/
.eslintcache
*.tsbuildinfo

# Editor / tooling
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.claude/settings.local.json

# Scratch, backup and duplicate files — never belong in the repo
*.bak
*.orig
*.rej
*.tmp
*~
* copy.*
* copy [0-9].*

# Uploaded media served from the services at runtime
Backend/Services/*/templates/static/uploads/

# Standalone nested repo, not part of this project
/hotelerp.in/
