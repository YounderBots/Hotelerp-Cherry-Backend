# =============================================================================
# Frontend config — TEMPLATE  (copy to Frontend/.env)
# =============================================================================
# Vite reads this at dev-server start (vite.config.js). Only VITE_-prefixed vars
# reach the browser bundle.
# =============================================================================

# Where the SPA sends API calls — the LoginServices gateway. Must be the LAN IP
# (not 127.0.0.1): the bundle runs in a browser on the *visiting* device.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev-server bind host/port. 0.0.0.0 makes the SPA reachable across the LAN.
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
