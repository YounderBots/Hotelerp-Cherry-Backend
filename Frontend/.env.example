# =============================================================================
# Frontend config — TEMPLATE  (copy to Frontend/.env)
# =============================================================================
# Vite reads this at dev-server start (vite.config.js). Only VITE_-prefixed vars
# reach the browser bundle.
# =============================================================================

# Where the SPA sends API calls — the LoginServices gateway. Must be the LAN IP
# (not 127.0.0.1): the bundle runs in a browser on the *visiting* device.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev-server bind host/port. 0.0.0.0 makes the SPA reachable across the LAN.
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# Where the "Request access" and "Forgot password" forms send their message.
# Both compose an email to an administrator rather than posting to an API —
# there is no self-service sign-up and no mail service behind the app.
VITE_ADMIN_CONTACT_EMAIL=admin@cherryhotel.com

# The property's own policy documents, linked from the consent checkbox on the
# access-request form. Leave blank and the wording appears without links rather
# than pointing at a page that does not exist.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
