# =============================================================================
# HotelERP — environment contract
# =============================================================================
# Copy to `.env` and fill in. Every value below marked REQUIRED must be set for
# ASCEND_ENV=production; the services raise at startup rather than falling back
# to a developer default.
#
# The same JWT_SECRET_KEY and JWT_ISSUER must be identical across ALL services
# — the gateway signs tokens and the other five verify them. A mismatch shows
# up as every authenticated request returning 401.
# =============================================================================

# ---- Environment ------------------------------------------------------------
# One of: local | dev | production
ASCEND_ENV=dev

# ---- Secrets (REQUIRED in production) ---------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
SESSION_SECRET=

# Issuer claim minted by LoginServices and verified by every other service.
JWT_ISSUER=hotelerp-login

# ---- Token lifetimes --------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ---- Database (REQUIRED in production) --------------------------------------
# Each service owns its own schema. Set DB_URI per-service in that service's
# process environment; the values below show the expected shape.
#
#   LoginServices / UserServices : mysql+pymysql://USER:PASS@HOST:3306/hotelerp_users
#   MasterDataServices           : mysql+pymysql://USER:PASS@HOST:3306/hotelerp_masterdata
#   HotelServices                : mysql+pymysql://USER:PASS@HOST:3306/hotelerp_hotel
#   RestaurantServices           : mysql+pymysql://USER:PASS@HOST:3306/hotelerp_restaurant
#   BarServices                  : mysql+pymysql://USER:PASS@HOST:3306/hotelerp_bar
DB_URI=

# Connection pool tuning (per service process).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- CORS -------------------------------------------------------------------
# Comma-separated allow-list. A literal "*" is stripped: it is invalid together
# with credentialed requests and would expose the API to any origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Internal service discovery (LoginServices gateway) ---------------------
USER_SERVICE_URL=http://127.0.0.1:8020
MASTER_SERVICE_URL=http://127.0.0.1:8030
HOTEL_SERVICE_URL=http://127.0.0.1:8040
RESTAURANT_SERVICE_URL=http://127.0.0.1:8050
BAR_SERVICE_URL=http://127.0.0.1:8060

# ---- Gateway behaviour ------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_BURST=3
PROXY_TIMEOUT_SECONDS=30
UPSTREAM_TIMEOUT_SECONDS=10

# ---- Uploads ----------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880

# ---- Frontend (Vite; must be prefixed VITE_ to be exposed to the bundle) -----
# Points the SPA at the LoginServices gateway, not at individual services.
VITE_API_BASE_URL=http://127.0.0.1:8000
